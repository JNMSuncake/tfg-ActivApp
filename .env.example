# ==========================================
# Configuración del Entorno Local - ActivApp
# ==========================================

# Base de Datos PostgreSQL (Docker)
POSTGRES_USER=activapp_admin
POSTGRES_PASSWORD=activapp_secret_pass
POSTGRES_DB=activapp_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://activapp_admin:activapp_secret_pass@localhost:5432/activapp_db?schema=public"

# Backend API
PORT=4000
NODE_ENV=development
JWT_SECRET=clave_secreta_jwt_desarrollo_activapp_2026_tfg
JWT_REFRESH_SECRET=clave_secreta_jwt_refresh_desarrollo_activapp_2026_tfg
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Web Push API (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@activapp.local

# Frontend PWA
VITE_API_URL=http://localhost:4000/api
